generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String               @id @default(uuid()) @db.Uuid
  email               String               @unique @db.VarChar(320)
  normalizedEmail     String               @unique @db.VarChar(320)
  name                String               @db.VarChar(100)
  passwordHash        String
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  categories          Category[]           @relation("UserCategories")
  expenses            Expense[]            @relation("UserExpenses")
  paidExpenses        Expense[]            @relation("ExpensePayer")
  budgets             Budget[]             @relation("UserBudgets")
  processedOperations ProcessedOperation[] @relation("UserProcessedOperations")
  createdGroups       ExpenseGroup[]       @relation("GroupCreator")
  groupMemberships    GroupMember[]        @relation("GroupMemberUser")
  expenseShares       ExpenseShare[]       @relation("ExpenseShareUser")
  settlementsSent     Settlement[]         @relation("SettlementFromUser")
  settlementsReceived Settlement[]         @relation("SettlementToUser")
  notificationDevices NotificationDevice[] @relation("UserNotificationDevices")
  receipts            Receipt[]            @relation("UserReceipts")

  @@index([updatedAt])
}

model ProcessedOperation {
  id            String   @id @default(uuid()) @db.Uuid
  operationId   String   @db.Uuid
  userId        String   @db.Uuid
  entityType    String
  entityId      String   @db.Uuid
  operationType String
  requestHash   String
  resultJson    String
  createdAt     DateTime @default(now())
  user          User     @relation("UserProcessedOperations", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, operationId])
  @@index([userId, entityType, entityId])
  @@index([createdAt])
}

model Category {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @db.Uuid
  name           String    @db.VarChar(100)
  normalizedName String    @db.VarChar(100)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  user           User      @relation("UserCategories", fields: [userId], references: [id], onDelete: Cascade)
  expenses       Expense[] @relation("CategoryExpenses")
  budgets        Budget[]  @relation("CategoryBudgets")

  @@unique([userId, normalizedName])
  @@index([userId])
  @@index([updatedAt])
}

model Expense {
  id           String         @id @default(uuid()) @db.Uuid
  userId       String         @db.Uuid
  paidByUserId String         @db.Uuid
  categoryId   String         @db.Uuid
  groupId      String?        @db.Uuid
  amountMinor  Int
  currency     String         @db.VarChar(3)
  description  String
  expenseDate  DateTime       @db.Date
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  version      Int            @default(1)
  deletedAt    DateTime?
  user         User           @relation("UserExpenses", fields: [userId], references: [id], onDelete: Cascade)
  paidByUser   User           @relation("ExpensePayer", fields: [paidByUserId], references: [id], onDelete: Restrict)
  category     Category       @relation("CategoryExpenses", fields: [categoryId], references: [id], onDelete: Restrict)
  group        ExpenseGroup?  @relation("GroupExpenses", fields: [groupId], references: [id], onDelete: SetNull)
  shares       ExpenseShare[] @relation("ExpenseShares")
  receipts     Receipt[]      @relation("ExpenseReceipts")

  @@index([userId])
  @@index([paidByUserId])
  @@index([categoryId])
  @@index([groupId])
  @@index([expenseDate])
  @@index([updatedAt])
}

model Receipt {
  id             String    @id @default(uuid()) @db.Uuid
  expenseId      String    @db.Uuid
  userId         String    @db.Uuid
  storageKey     String    @unique @db.VarChar(512)
  originalName   String    @db.VarChar(255)
  mimeType       String    @db.VarChar(64)
  sizeBytes      Int
  checksumSha256 String    @db.VarChar(64)
  createdAt      DateTime  @default(now())
  deletedAt      DateTime?
  expense        Expense   @relation("ExpenseReceipts", fields: [expenseId], references: [id], onDelete: Cascade)
  user           User      @relation("UserReceipts", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([expenseId, checksumSha256])
  @@index([userId])
  @@index([expenseId])
}

enum GroupRole {
  OWNER
  MEMBER
}

model ExpenseGroup {
  id          String        @id @default(uuid()) @db.Uuid
  name        String        @db.VarChar(100)
  createdById String        @db.Uuid
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  createdBy   User          @relation("GroupCreator", fields: [createdById], references: [id], onDelete: Restrict)
  members     GroupMember[] @relation("GroupMembers")
  expenses    Expense[]     @relation("GroupExpenses")
  settlements Settlement[]  @relation("GroupSettlements")

  @@index([createdById])
  @@index([updatedAt])
}

model GroupMember {
  groupId  String       @db.Uuid
  userId   String       @db.Uuid
  role     GroupRole    @default(MEMBER)
  joinedAt DateTime     @default(now())
  group    ExpenseGroup @relation("GroupMembers", fields: [groupId], references: [id], onDelete: Cascade)
  user     User         @relation("GroupMemberUser", fields: [userId], references: [id], onDelete: Cascade)

  @@id([groupId, userId])
  @@index([userId])
  @@index([groupId, role])
}

model ExpenseShare {
  id          String   @id @default(uuid()) @db.Uuid
  expenseId   String   @db.Uuid
  userId      String   @db.Uuid
  amountMinor Int
  createdAt   DateTime @default(now())
  expense     Expense  @relation("ExpenseShares", fields: [expenseId], references: [id], onDelete: Cascade)
  user        User     @relation("ExpenseShareUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([expenseId, userId])
  @@index([userId])
  @@index([expenseId])
}

model Settlement {
  id          String       @id @default(uuid()) @db.Uuid
  groupId     String       @db.Uuid
  fromUserId  String       @db.Uuid
  toUserId    String       @db.Uuid
  amountMinor Int
  settledAt   DateTime
  createdAt   DateTime     @default(now())
  group       ExpenseGroup @relation("GroupSettlements", fields: [groupId], references: [id], onDelete: Cascade)
  fromUser    User         @relation("SettlementFromUser", fields: [fromUserId], references: [id], onDelete: Restrict)
  toUser      User         @relation("SettlementToUser", fields: [toUserId], references: [id], onDelete: Restrict)

  @@index([groupId, settledAt])
  @@index([fromUserId])
  @@index([toUserId])
}

model Budget {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  categoryId  String?   @db.Uuid
  amountMinor Int
  month       Int
  year        Int
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation("UserBudgets", fields: [userId], references: [id], onDelete: Cascade)
  category    Category? @relation("CategoryBudgets", fields: [categoryId], references: [id], onDelete: Restrict)

  // PostgreSQL partial unique indexes in the fix_budget_uniqueness migration
  // enforce one overall (NULL category) and one category-specific budget per
  // user/month/year. Prisma schema syntax cannot represent partial indexes.
  @@index([userId])
  @@index([categoryId])
  @@index([updatedAt])
}

model NotificationDevice {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  pushToken  String   @unique @db.VarChar(512)
  platform   String   @db.VarChar(16)
  enabled    Boolean  @default(true)
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation("UserNotificationDevices", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([enabled])
}

// Ownership checks are mandatory in the service layer: before creating or
// updating an Expense or Budget, verify that its Category belongs to the
// authenticated user. Foreign keys do not establish that cross-relation.
